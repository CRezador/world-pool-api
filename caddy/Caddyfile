# Caddy faz o TLS (Let's Encrypt automático) e roteia por domínio:
#   - FRONT_DOMAIN  -> front  (SPA estático; ele já faz proxy interno de /api e /sanctum)
#   - API_DOMAIN    -> api    (acesso direto à API: Postman, integrações, etc.)
# O SPA continua chamando /api na MESMA origem do front (sem CORS); o domínio da
# API é publicado em paralelo para consumo direto.
{
	email {$ACME_EMAIL}
}

{$FRONT_DOMAIN} {
	encode zstd gzip
	reverse_proxy front:80
}

{$API_DOMAIN} {
	encode zstd gzip
	reverse_proxy api:80
}
