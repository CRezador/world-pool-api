# Configuração de produção (VPS). Copie para .env.prod e preencha os valores reais:
#   cp .env.prod.example .env.prod
# .env.prod NÃO deve ser commitado (já está no .gitignore).

# === Domínios / TLS (Caddy) ===
# Dois domínios apontando para o IP da VPS (registros A iguais):
#   FRONT_DOMAIN = onde o SPA é servido (o SPA chama /api na MESMA origem)
#   API_DOMAIN   = acesso direto à API (Postman, integrações)
FRONT_DOMAIN=bolao.caiorezador.com
API_DOMAIN=api.caiorezador.com
ACME_EMAIL=seu-email@exemplo.com

# === Banco de dados (MySQL) ===
DB_DATABASE=pool_api
DB_USERNAME=pool
DB_PASSWORD=troque-esta-senha-forte
MYSQL_ROOT_PASSWORD=troque-esta-senha-root

# === Aplicação Laravel ===
APP_NAME="Bolão Copa"
APP_ENV=production
APP_DEBUG=false
# Gere com: docker compose --env-file .env.prod -f docker-compose.prod.yml run --rm api php artisan key:generate --show
APP_KEY=
APP_URL=https://bolao.caiorezador.com

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306

# O SPA é servido pelo front e chama /api na MESMA origem (bolao.*), então o
# Sanctom/sessão usam o domínio do front. Sem CORS no fluxo do SPA.
SESSION_DRIVER=database
SESSION_DOMAIN=bolao.caiorezador.com
SESSION_SECURE_COOKIE=true
FRONTEND_URL=https://bolao.caiorezador.com
SANCTUM_STATEFUL_DOMAINS=bolao.caiorezador.com

CACHE_STORE=database
QUEUE_CONNECTION=database

LOG_CHANNEL=stack
LOG_LEVEL=error

# Token da API football-data (se usado em produção)
FOOTBALL_DATA_TOKEN=
