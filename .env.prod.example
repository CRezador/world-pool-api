# Configuração de produção (VPS). Copie para .env.prod e preencha os valores reais:
#   cp .env.prod.example .env.prod
# .env.prod NÃO deve ser commitado (já está no .gitignore).

# === Domínio / TLS (Caddy) ===
DOMAIN=bolao.seudominio.com
ACME_EMAIL=seu-email@exemplo.com

# === Banco de dados (MySQL) ===
DB_DATABASE=pool_api
DB_USERNAME=pool
DB_PASSWORD=troque-esta-senha-forte
MYSQL_ROOT_PASSWORD=troque-esta-senha-root

# === Aplicação Laravel ===
APP_NAME="Bolão Copa"
APP_ENV=production
APP_DEBUG=false
# Gere com: docker compose --env-file .env.prod -f docker-compose.prod.yml run --rm api php artisan key:generate --show
APP_KEY=
APP_URL=https://bolao.seudominio.com

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306

# Front e API são servidos na MESMA origem (Caddy → front → api), então
# os domínios statefuls do Sanctum e o cookie de sessão usam o domínio público.
SESSION_DRIVER=database
SESSION_DOMAIN=bolao.seudominio.com
FRONTEND_URL=https://bolao.seudominio.com
SANCTUM_STATEFUL_DOMAINS=bolao.seudominio.com

CACHE_STORE=database
QUEUE_CONNECTION=database

LOG_CHANNEL=stack
LOG_LEVEL=error

# Token da API football-data (se usado em produção)
FOOTBALL_DATA_TOKEN=
