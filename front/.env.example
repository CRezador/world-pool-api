VITE_API_BASE_URL=http://localhost:8080/api

# Alvo do proxy /api do Vite dentro do container (use host.docker.internal
# para chamar a API rodando no host, ou o nome do servico no compose).
VITE_PROXY_TARGET=http://host.docker.internal:8080

# Build de producao (Dockerfile.prod): alvo do proxy_pass do nginx.
# Precisa incluir o esquema (http:// ou https://). No Railway, aponte para o
# servico da API: ex. http://api.railway.internal:8080 (rede interna) ou o
# dominio publico https://api-xxx.up.railway.app
API_URL=http://localhost:8080
